{{- /* Insights feed: listed posts only, newest first */ -}}
{{- $posts := (where (where .RegularPages "Params.unlisted" "ne" true) "Params.noindex" "ne" true).ByPublishDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Params.seo_title | default .Title }} - {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ partial "seo/description" . }}</description>
    <language>{{ site.LanguageCode }}</language>
    <copyright>{{ site.Copyright }}</copyright>
    {{- with $posts }}
    <lastBuildDate>{{ (index . 0).PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $posts }}
    <item>
      <title>{{ .Title | plainify }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with .Params.author }}{{ with index site.Data.authors . }}
      <author>{{ .email }} ({{ .name }})</author>
      {{- end }}{{ end }}
      <description>{{ partial "seo/description" . }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
